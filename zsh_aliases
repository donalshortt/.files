# Git aliases
alias gtc="git log -- "
alias glf="git log --follow -p "
alias gco--="git checkout @{-2}"
alias gco---="git checkout @{-3}"

gdif() {
    git diff "$@" | delta --line-numbers
}

wta() {
	git fetch origin &&
	git worktree add -b "$1" "../unnamed_$1" HEAD &&
	cd "../unnamed_$1"
}
