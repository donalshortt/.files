alias v="nvim ${1}"
alias lc="nvim leetcode.nvim"
alias c="z ${1}"
alias c-="cd -"
alias open="xdg-open ${1}"
alias sd="shutdown -h 0"
alias gdb="gdb -q"
alias clip="xclip -selection clipboard"
alias ws="wormhole send ${1}"
alias wr="wormhole recieve ${1}"
alias bc="better-commits"
alias pe="pet exec"
alias sysup="yay -Syu --noconfirm"
alias gu="gaa; gc -m \"latest\"; gp"
alias cr="RUST_BACKTRACE=1 cargo run"
alias crr="RUST_BACKTRACE=1 cargo run --release"
alias cl="cargo clippy --all-targets --all-features -- -D warnings"
alias clr="cargo clippy --release --all-targets --all-features -- -D warnings"
alias sev="sudo systemctl restart evremap.service"
alias stev="sudo systemctl stop evremap.service"
alias sedit="nvim /usr/lib/systemd/system/evremap.service"
alias ye="yay -Sy --noconfirm ${2}"
alias rr="evcxr"
alias bat="bat --paging=never ${1}"
alias lock="xscreensaver-command -lock"
alias telnet="rlwrap telnet ${1}"

# Git aliases
alias gtc="git log -- ${1}"
alias glf="git log --follow -p ${1}"
alias gco--="git checkout @{-2}"
alias gco---="git checkout @{-3}"
alias wta="gwta ../unnamed_${1} ${1}"

gdif() {
    git diff "$@" | delta --line-numbers
}
